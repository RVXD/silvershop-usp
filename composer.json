{
    "name": "silvershop-suite/usp",
    "description": "CMS-managed USPs, trust signals and an announcement/promo bar for SilverStripe. Works on any site; shop-specific placements (PDP / cart / checkout) light up when silvershop/core is present.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "usp", "trust", "announcement", "promo", "payment-badges"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/admin": "^3",
        "silverstripe/siteconfig": "^6",
        "silverstripe/asset-admin": "^3"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "suggest": {
        "silvershop/core": "Enables the shop placements (PDP, cart and checkout trust strips); the module is inert on those surfaces without it.",
        "symbiote/silverstripe-gridfieldextensions": "Adds drag-and-drop ordering to the USP list in the CMS.",
        "tractorcow/silverstripe-fluent": "Localises the USP content fields when installed."
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Usp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Usp\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
